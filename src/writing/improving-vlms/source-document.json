        }
      }
    },
    {
      "elements": [
        {
          "startIndex": 1704,
          "endIndex": 1728,
          "textRun": {
            "content": "Relational understanding",
            "textStyle": {
              "bold": true
            }
          }
        },
        {
          "startIndex": 1728,
          "endIndex": 1767,
          "textRun": {
            "content": ": spatial and temporal relationships. \n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT",
        "indentFirstLine": {
