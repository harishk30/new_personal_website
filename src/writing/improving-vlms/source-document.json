          "textRun": {
            "content": "\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 1533,
          "endIndex": 1534,
          "textRun": {
            "content": "\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 1534,
          "endIndex": 1630,
          "textRun": {
            "content": "To investigate this further, we classify every WorldBench question into one of four categories:\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 1630,
          "endIndex": 1655,
          "textRun": {
            "content": "Perception and extraction",
            "textStyle": {
              "bold": true
            }
          }
        },
        {
          "startIndex": 1655,
          "endIndex": 1704,
          "textRun": {
            "content": ": OCR, counting, attributes, and small details. \n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT",
        "indentFirstLine": {
