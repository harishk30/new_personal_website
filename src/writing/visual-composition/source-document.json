      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 5571,
          "endIndex": 5669,
          "textRun": {
            "content": "(embed in trajectory examples of where scaffolding takes responses from 0/8 -> some solved here) \n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 5669,
          "endIndex": 5670,
          "textRun": {
            "content": "\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 5670,
          "endIndex": 5888,
          "textRun": {
            "content": "However, is this coverage/reliability tradeoff ubiquitous for all visual harnesses, or a function of how the policy is trained and deployed? To investigate this, we evaluate GPT-6 Luna at varying levels of reasoning. \n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
