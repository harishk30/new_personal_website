        "textStyle": {}
      }
    },
    {
      "elements": [
        {
          "startIndex": 3868,
          "endIndex": 3892,
          "textRun": {
            "content": "Relational understanding",
            "textStyle": {
              "bold": true
            }
          }
        },
        {
          "startIndex": 3892,
          "endIndex": 3931,
          "textRun": {
            "content": ": spatial and temporal relationships. \n",
            "textStyle": {}
          }
        }
      ],
