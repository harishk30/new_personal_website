            "textStyle": {
              "bold": true
            }
          }
        },
        {
          "startIndex": 4039,
          "endIndex": 4108,
          "textRun": {
            "content": ": world understanding, language, conventions, and domain knowledge. \n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT",
