        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4288,
          "endIndex": 4316,
          "textRun": {
            "content": "Reachability vs Reliability\n",
            "textStyle": {
              "bold": true
            }
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4316,
          "endIndex": 4317,
          "textRun": {
            "content": "\n",
            "textStyle": {
              "bold": true
            }
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4317,
          "endIndex": 4584,
          "textRun": {
            "content": "To see where harness changes can improve VLM performance, we measure the performance of Qwen-3.6 27B and Qwen 3.5 397B (A17B) in the Codex harness across eight rollouts, allowing it to analyze images programmatically using Python, with Pillow and NumPy preinstalled. ",
            "textStyle": {}
          }
        },
        {
          "startIndex": 4584,
          "endIndex": 4585,
          "textRun": {
            "content": "\n",
            "textStyle": {
              "bold": true
            }
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4585,
          "endIndex": 4586,
          "textRun": {
            "content": "\n",
            "textStyle": {
              "bold": true
            }
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4586,
          "endIndex": 4635,
          "textRun": {
            "content": "(Use two aligned panels, one per model, showing:\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 4635,
          "endIndex": 4680,
          "textRun": {
            "content": "No-harness versus harness Pass@1 and Pass@8.\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT",
        "spaceAbove": {
          "magnitude": 12,
          "unit": "PT"
        },
