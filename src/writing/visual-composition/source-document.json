    {
      "elements": [
        {
          "startIndex": 4680,
          "endIndex": 4753,
          "textRun": {
            "content": "Below them, the distribution of questions with 0–8 successful attempts.)\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT",
        "spaceAbove": {
