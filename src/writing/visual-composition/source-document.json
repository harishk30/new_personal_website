            "content": "\n",
            "textStyle": {}
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
      }
    },
    {
      "elements": [
        {
          "startIndex": 5889,
          "endIndex": 5919,
          "textRun": {
            "content": "Making Harness Gains Reliable\n",
            "textStyle": {
              "bold": true
            }
          }
        }
      ],
      "paragraphStyle": {
        "namedStyleType": "NORMAL_TEXT",
        "direction": "LEFT_TO_RIGHT"
